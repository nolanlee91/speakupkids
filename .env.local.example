# SpeakUp Kids · biến môi trường (sao chép file này thành .env.local rồi điền)
#
# ── Client (trình duyệt) — LẤY Ở: Supabase → Project Settings → API ──
# An toàn để lộ ra client (anon key chỉ hoạt động kèm RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Server (CHỈ dùng trong Supabase Edge Function — KHÔNG bao giờ để lộ ra client) ──
# Đặt các key này ở: Supabase → Edge Functions → Secrets (không commit, không NEXT_PUBLIC_)
# SUPABASE_SERVICE_ROLE_KEY=      # để function đọc mọi con + gửi mail (bỏ qua RLS)
# RESEND_API_KEY=                 # lấy ở resend.com → API Keys
# REPORT_FROM_EMAIL=             # vd: "SpeakUp Kids <bao-cao@your-domain.com>"
